<!DOCTYPE html>
<html>

<head>
    <title>All Users</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="container">

    <h1>All Users</h1>

    <% if (users && users.length > 0) { %>

        <% users.forEach(user => { %>

            <div class="card">

                <h2>
                    <%= user.firstName %>
                    <%= user.lastName %>
                </h2>

                <p>
                    <strong>Email:</strong>
                    <%= user.email %>
                </p>

                <p>
                    <strong>Phone:</strong>
                    <%= user.phone %>
                </p>

                <a href="/users/<%= user._id %>">
                    View Profile
                </a>

            </div>

        <% }) %>

    <% } else { %>

        <p>No users found.</p>

    <% } %>


    <% if (parent && children && children.length > 0) { %>

        <h2>
            Children of
            <%= parent.firstName %>
            <%= parent.lastName %>
        </h2>

        <% children.forEach(child => { %>

            <div class="card">

                <h3>
                    <%= child.firstName %>
                    <%= child.lastName %>
                </h3>

                <p>
                    Age:
                    <%= child.age %>
                </p>

                <p>
                    Email:
                    <%= child.email %>
                </p>

                <a href="/users/<%= parent._id %>/children/<%= child._id %>">
                    View Child
                </a>

            </div>

        <% }) %>

    <% } %>


    <br>

    <a href="/">
        Home
    </a>

</div>

</body>

</html>