<!DOCTYPE html>
<html>

<head>

    <title>
        <%= user.firstName %> <%= user.lastName %>
    </title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

    <!-- ============================= -->
    <!-- USER PROFILE -->
    <!-- ============================= -->

    <h1>User Profile</h1>

    <div class="card">

        <h2>
            <%= user.firstName %>
            <%= user.lastName %>
        </h2>

        <p>
            <strong>Email:</strong>
            <%= user.email %>
        </p>

        <p>
            <strong>Phone:</strong>
            <%= user.phone %>
        </p>

    </div>


    <!-- ============================= -->
    <!-- DELETE USER -->
    <!-- ============================= -->

    <div class="card">

        <h2>Delete User</h2>

        <p>
            Deleting this user will also delete
            all children belonging to this user.
        </p>

        <form
            action="/users/<%= user._id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this user and all their children?');"
        >

            <button type="submit">
                Delete User
            </button>

        </form>

    </div>


    <!-- ============================= -->
    <!-- CHILDREN -->
    <!-- ============================= -->

    <h2>Children</h2>


    <% if (children.length === 0) { %>

        <div class="card">

            <p>
                No children found for this user.
            </p>

        </div>

    <% } else { %>


        <% children.forEach(child => { %>

            <div class="card">

                <h3>
                    <%= child.firstName %>
                    <%= child.lastName %>
                </h3>

                <p>
                    <strong>Age:</strong>
                    <%= child.age %>
                </p>

                <p>
                    <strong>Email:</strong>
                    <%= child.email %>
                </p>


                <!-- View Child -->

                <a
                    href="/users/<%= user._id %>/children/<%= child._id %>"
                >
                    View Child
                </a>


                <br><br>


                <!-- Delete Child -->

                <form
                    action="/children/<%= child._id %>?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this child?');"
                >

                    <button type="submit">
                        Delete Child
                    </button>

                </form>

            </div>

        <% }) %>

    <% } %>


    <!-- ============================= -->
    <!-- ADD CHILD -->
    <!-- ============================= -->

    <h2>Add Child</h2>

    <div class="card">

        <form
            action="/users/<%= user._id %>/children"
            method="POST"
        >

            <label>
                First Name
            </label>

            <input
                type="text"
                name="firstName"
                placeholder="Enter first name"
                required
            >


            <label>
                Last Name
            </label>

            <input
                type="text"
                name="lastName"
                placeholder="Enter last name"
                required
            >


            <label>
                Age
            </label>

            <input
                type="number"
                name="age"
                placeholder="Enter age"
                min="0"
                required
            >


            <label>
                Email
            </label>

            <input
                type="email"
                name="email"
                placeholder="Enter email"
                required
            >


            <button type="submit">
                Add Child
            </button>

        </form>

    </div>


    <br>


    <!-- ============================= -->
    <!-- NAVIGATION -->
    <!-- ============================= -->

    <a href="/users">
        View All Users
    </a>

    <br><br>

    <a href="/">
        Home
    </a>

</div>

</body>

</html>